# NetBox Env config - Managed by Ansible/Jinja2
# DB
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD={{ netbox_postgres_pass }}

# App
REDIS_HOST=127.0.0.1
DB_TIMEOUT=300
DB_WAIT_DEBUG=1
DB_HOST=127.0.0.1
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD={{ netbox_postgres_pass }}
SECRET_KEY={{ netbox_secret_key }}
ALLOWED_HOSTS={{ netbox_allowed_hosts }}
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_pass }}
