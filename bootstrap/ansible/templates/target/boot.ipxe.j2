#!ipxe
# PXE containerized boot.ipxe - Managed by Ansible/Jinja2
# Ensure the network interface is up
isset ${net0/ip} || dhcp

# Architecture Detection
# If ${arch} is empty, default to x86_64, otherwise jump to its specific block
# iPXE uses 'arm64', but often ISOs use 'aarch64' as the folder name so need to map iPXE 'arm64' to common 'aarch64' naming convention
isset ${arch} && goto arch_${arch} || goto arch_x86_64

:arch_x86_64
set arch_path x86_64
goto vars_complete

:arch_arm64
set arch_path aarch64
goto vars_complete

:arch_riscv64
set arch_path riscv64
goto vars_complete

:vars_complete
# Global Variables
set base_url http://{{ remote_server_ip }}:{{ pxe_http_port }}

:start
menu Generic iPXE Boot Menu [Arch: ${arch}]
item --gap --             ---------------- Operating Systems ----------------
item rescue               System Rescue (Generic)
item --gap --             ---------------- Advanced -------------------------
item shell                Drop to iPXE Shell
item reboot               Reboot Computer
choose --default shell --timeout 5000 target && goto ${target}

:rescue
echo Loading Rescue Environment...
kernel ${base_url}/${arch}/rescue/vmlinuz ip=dhcp
initrd ${base_url}/${arch}/rescue/initrd.img
boot

:shell
shell

:reboot
reboot
