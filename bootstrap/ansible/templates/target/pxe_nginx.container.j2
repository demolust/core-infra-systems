[Unit]
Description=PXE nginx Component
After=pxe-pod.service
BindsTo=pxe-pod.service
PartOf=pxe-pod.service

[Container]
ContainerName=pxe_nginx
Image=docker.io/library/nginx:alpine
Volume={{ pxe_base_dir }}/configs/nginx.conf:/etc/nginx/nginx.conf:ro,Z
Volume={{ pxe_base_dir }}/www:/usr/share/nginx/html:ro,Z
Pod=pxe.pod

[Service]
Restart=on-failure
StartLimitIntervalSec=30
StartLimitBurst=5
