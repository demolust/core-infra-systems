# PXE containerized dnsmasq.conf - Managed by Ansible/Jinja2
# Only listen on the defined interface
interface={{ bootstrap_interface }}
#bind-interfaces
bind-dynamic

# Disable DNS functionality (since only need DHCP/TFTP)
port=0

# DHCP Range (Isolated/Direct Connect)
dhcp-range={{ bootstrap_ip_range_1 }},{{ bootstrap_ip_range_2 }},12h

# Route target traffic to the Host IP (Gateway)
dhcp-option=3,{{ bootstrap_ip }}
# Provide DNS (Host IP if dnsmasq handles DNS, or public DNS)
dhcp-option=6,8.8.8.8,1.1.1.1

# Identify Architectures
dhcp-match=set:x86_64,option:client-arch,7
dhcp-match=set:x86_64,option:client-arch,9
dhcp-match=set:aarch64,option:client-arch,11

dhcp-userclass=set:is_ipxe,iPXE
dhcp-boot=tag:is_ipxe,http://{{ bootstrap_ip }}/{{ selected_arch }}/boot.ipxe

# Assign Bootloader based on Architecture + SB Variable
{% if sb_enabled -%}
  dhcp-boot=tag:x86_64,tag:!is_ipxe,/x86_64/{{ boot_files['x86_64'].shim }},{{ bootstrap_ip }},{{ bootstrap_ip }}
  dhcp-boot=tag:aarch64,tag:!is_ipxe,/aarch64/{{ boot_files['aarch64'].shim }},{{ bootstrap_ip }},{{ bootstrap_ip }}
{%- else -%}
  dhcp-boot=tag:x86_64,tag:!is_ipxe,/x86_64/ipxe.efi,{{ bootstrap_ip }},{{ bootstrap_ip }}
  dhcp-boot=tag:aarch64,tag:!is_ipxe,/aarch64/ipxe.efi,{{ bootstrap_ip }},{{ bootstrap_ip }}
{%- endif %}

# Force a safe MTU
dhcp-option=26,1460

# Enable logging
log-facility=-
log-dhcp
log-queries
