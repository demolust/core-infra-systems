# ==============================================================================
# Instructions: Copy this to '.env' and fill in actual values
# Load the values before running the playbook: source ./.env
# '.env' is excluded from version control locally.
# ==============================================================================

# --- Production Nodes: Static DHCP Reservations ---
# Supply all reservations, including existing hosts; this replaces dhcp-hosts.conf.
# Keep the JSON array on one line and single-quoted; add/remove objects as needed.
# Get each host's MAC with 'ip link'; choose a unique IP outside its VLAN's DHCP pool.
# ref_name identifies the host; name supplies the short DHCP hostname for Proxmox.
# The internal domain is already configured by network node setup.
export TARGET_DHCP_RESERVATIONS_JSON='[{"mac":"02:00:00:00:00:10","ipv4":"192.0.2.10","ref_name":"control","name":"control"},{"mac":"02:00:00:00:00:21","ipv4":"192.0.2.21","ref_name":"prod01","name":"prod01"},{"mac":"02:00:00:00:00:22","ipv4":"192.0.2.22","ref_name":"prod02","name":"prod02"}]'

# --- Production Nodes: PXE Boot Server ---
# Select the DHCP reservation whose ref_name exactly matches this value (case-sensitive).
# Its ipv4 is used in the generated iPXE scripts to reach the control node.
export TARGET_PXE_SERVER_REF='control'

# --- Production Nodes: Proxmox Host Selection ---
# Match reservation ref_names with a regular expression, e.g. ^prod[0-9]+$.
# Each selected ref_name must have an entry in PROXMOX_SETTINGS_JSON.
export PROXMOX_REF_PATTERN='^prod[0-9]+$'

# --- Production Nodes: Shared Proxmox Installer Settings ---
# Use the two-letter country code, e.g. mx or us.
export PROXMOX_COUNTRY='<COUNTRY_CODE>'
# Use an IANA timezone name, e.g. America/Monterrey.
export PROXMOX_TIMEZONE='<TIMEZONE>'
# Email address for Proxmox system notifications.
export PROXMOX_MAILTO='<EMAIL>'

# --- Production Nodes: Per-Host Proxmox Installation Settings ---
# Keep the JSON object on one line and single-quoted; keys match reservation ref_names.
# arch: use x86_64 or aarch64 to match the prepared installer directory.
# keyboard: use the installer keyboard layout, e.g. en-us.
# root_password_hash: generate a SHA-512 hash with: openssl passwd -6
# ssh_keys: paste full SSH public keys, e.g. ["ssh-ed25519 AAA..."].
# filesystem: use ext4, xfs, or zfs with the current answer template.
# disks: select installation disks without /dev/, e.g. ["nvme0n1"].
# zfs_raid: include for ZFS, e.g. raid1 with two disks; omit for ext4/xfs.
export PROXMOX_SETTINGS_JSON='{"prod01":{"arch":"x86_64","keyboard":"<KEYBOARD>","root_password_hash":"<ROOT_PASSWORD_HASH>","ssh_keys":["<SSH_PUBLIC_KEY>"],"filesystem":"ext4","disks":["<INSTALL_DISK>"]},"prod02":{"arch":"aarch64","keyboard":"<KEYBOARD>","root_password_hash":"<ROOT_PASSWORD_HASH>","ssh_keys":["<SSH_PUBLIC_KEY>"],"filesystem":"zfs","disks":["<INSTALL_DISK_1>","<INSTALL_DISK_2>"],"zfs_raid":"raid1"}}'

# --- Production Nodes: Run Provisioning ---
# Run from this directory after loading .env:
# ansible-playbook -i ../control/inventories/control_nodes.yml -i ../network/inventories/network_nodes.yml proxmox_setup_pxe_boot_files.yml
