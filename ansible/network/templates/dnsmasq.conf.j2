# Containerized dnsmasq.conf - Managed by Ansible/Jinja2

# Add loopback for FQDN
interface=lo
# Listen on host's VLAN interfaces
{% for vlan in router_vlans %}
interface=lan0.{{ vlan.id }}
{% endfor %}
bind-dynamic

# Enable local DNS functionality only a specific port to allow fowarding FQDN to the DNS server
port={{ local_fwd_dns_port }}
domain={{ lab_domain }}
local=/{{ lab_domain }}/
dhcp-option=option:domain-search,{{ lab_domain }}
interface-name={{ ansible_facts['hostname'] }}.{{ lab_domain }},lan0.10/4

# Load static DHCP reservations and persist dynamic leases
dhcp-hostsfile=/etc/dnsmasq.d/dhcp-hosts.conf
dhcp-leasefile=/var/lib/dnsmasq/dnsmasq.leases

{% for vlan in router_vlans %}
{% set subnet = vlan.ipv4.split('.')[0:3] | join('.') %}
# VLAN {{ vlan.id }} ({{ vlan.name }})
dhcp-range=set:vlan{{ vlan.id }},{{ subnet }}.100,{{ subnet }}.200,255.255.255.0,24h
dhcp-option=tag:vlan{{ vlan.id }},option:router,{{ vlan.ipv4 }}
dhcp-option=tag:vlan{{ vlan.id }},option:dns-server,{{ vlan.ipv4 }}

{% endfor %}

# PXE boot instructions, boot files are served by the control node.
# Identify Architectures
dhcp-match=set:pxe_x86_64,option:client-arch,7
dhcp-match=set:pxe_x86_64,option:client-arch,9
dhcp-match=set:pxe_aarch64,option:client-arch,11
# Identify if the requester is iPXE
#dhcp-match=set:is_ipxe, 175
dhcp-userclass=set:is_ipxe,iPXE

# If Secure Boot is ON, point to signed ipxe
#dhcp-boot=tag:!is_ipxe,tag:pxe_x86_64,/ipxeboot/x86_64-sb/ipxe-shim.efi,,{{ pxe_server_ip }}
#dhcp-boot=tag:!is_ipxe,tag:pxe_aarch64,/ipxeboot/arm64-sb/ipxe-shim.efi,,{{ pxe_server_ip }}
# If Secure Boot is ON, point to signed SHIM, not GRUB
#dhcp-boot=tag:!is_ipxe,tag:pxe_x86_64,/x86_64/shimx64.efi,,{{ pxe_server_ip }}
#dhcp-boot=tag:!is_ipxe,tag:pxe_aarch64,/aarch64/shimaa64.efi,,{{ pxe_server_ip }}

# If Secure Boot is OFF, always point to ipxe
# Initial UEFI PXE boot: serve the iPXE binary
dhcp-boot=tag:!is_ipxe,tag:pxe_x86_64,/x86_64/ipxe.efi,,{{ pxe_server_ip }}
dhcp-boot=tag:!is_ipxe,tag:pxe_aarch64,/aarch64/ipxe.efi,,{{ pxe_server_ip }}
# Second boot stage (iPXE makes a request): serve the script via HTTP or TFTP
# HTTP
#dhcp-boot=tag:is_ipxe,http://{{ pxe_server_ip }}/ipxe/configs/boot.ipxe
# TFTP
dhcp-boot=tag:is_ipxe,/ipxe/configs/boot.ipxe,,{{ pxe_server_ip }}

# Force a safe MTU
dhcp-option=26,1460

# Enable logging
log-facility=-
log-dhcp
log-queries
