# ==============================================================================
# Copy this to '.env', fill in actual values, then run: source ./.env
# '.env' is already on '.gitignore'. Keep password hashes in single quotes.
# ==============================================================================

# --- Bootstrap Node: Network Interfaces ---
# Use 'ip link' to find to find actual interface names of the bootstrap host
export BOOTSTRAP_INT="<WHERE_PXE_WILL_BE_USED>"
export WAN_INT="<WHERE_INTERNET_CONNECTION_IS>"

# --- Network Node: System Architecture & Host Info ---
# Secure Boot: Use `True` or `False` depending on how the network node will be configured
export TARGET_SB_ENABLED=True
# Use `x86_64` or `aarch64` depending on how the network node will be configured
export TARGET_HOST_ARCH="x86_64"
export TARGET_HOST_ADMIN="<ADMIN_USERNAME>"
export TARGET_HOST_NAME="<TARGET_HOSTNAME>"
export TARGET_HOST_TZ="<TARGET_TZ>"

# --- Network Node: User & Password Settings ---
# Generate each SHA-512 hash using: openssl passwd -6
export TARGET_ROOT_PASSWORD_HASH='<REPLACE_WITH_SHA512_HASH>'
export TARGET_ADMIN_PASSWORD_HASH='<REPLACE_WITH_SHA512_HASH>'
# Paste the full SSH public key used to connect to the node.
export TARGET_ADMIN_SSH_PUB_KEY="<SSH_PUBLIC_KEY>"

# --- Network Node: AdGuard Home ---
export TARGET_ADGUARD_ADMIN="<ADMIN_USER>"
# Generate bcrypt using: htpasswd -nB -C 10 admin (requires httpd-tools/apache2-utils)
# Copy only the hash after 'admin:'; keep it single-quoted.
export TARGET_ADGUARD_ADMIN_PASS='<REPLACE_WITH_BCRYPT_HASH>'

# --- Network Node: WireGuard ---
# UDP listen port, e.g. 51820
export TARGET_WIREGUARD_PORT="<PORT>"
# Generate once: umask 077; wg genkey > server-private.key
# Derive the public key: wg pubkey < server-private.key > server-public.key
# Paste the private key below; give clients only the public key.
export TARGET_WIREGUARD_PRIV_KEY="<WG_SERVER_PRIVATE_KEY>"

# --- Network Node: DuckDNS & Local DNS ---
# Register at duckdns.org; use the subname (my-lab for my-lab.duckdns.org) and account token.
export TARGET_DDNS_DOMAIN="<DUCKDNS_SUBDOMAIN>"
export TARGET_DDNS_TOKEN="<DUCKDNS_ACCOUNT_TOKEN>"
# Internal LAN domain, e.g. lab.home.arpa
export TARGET_LAB_DOMAIN="<LOCAL_DOMAIN>"

# --- Network Node: Static DHCP Reservations ---
# Keep each JSON array on one line for direnv; add/remove objects or use []. ref_name and name are optional.
# Get each host's MAC with 'ip link'; choose a unique IP in its LAN subnet.
export TARGET_DHCP_RESERVATIONS_JSON='[{"mac":"02:00:00:00:10:01","ipv4":"172.16.10.10","ref_name":"Control node","name":"control-01"}]'

# --- Network Node: WireGuard Peers ---
# Keep each JSON array on one line for direnv; add/remove objects or use []. vpn_ip is unique and has no /32 suffix.
# pub_key is the CLIENT public key; keep its private key on the client.
# New client keys: umask 077; wg genkey > client-private.key
#                 wg pubkey < client-private.key > client-public.key
# Per-client preshared key: wg genpsk (configure the same key on server and client).
# Reuse existing keys on later runs.
export TARGET_WIREGUARD_PEERS_JSON='[{"name":"example-laptop","pub_key":"<CLIENT_PUBLIC_KEY>","preshared_key":"<CLIENT_PRESHARED_KEY>","vpn_ip":"10.100.0.2"}]'
