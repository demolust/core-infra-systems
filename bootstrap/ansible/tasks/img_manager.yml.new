---
- name: Set variables for the rest of the run
  ansible.builtin.set_fact:
    os_base: "AlmaLinux"
    base_url: "repo.almalinux.org/almalinux"
    version: "9"
    iso_type: "dvd"
    boot_files:
      x86_64:
        efi_loader: "EFI/BOOT/BOOTX64.EFI"
        grub_efi: "EFI/BOOT/grubx64.efi"
        shim: "BOOTX64.EFI"
        ipxe_arch: "x86_64-efi"
      aarch64:
        efi_loader: "EFI/BOOT/BOOTAA64.EFI"
        grub_efi: "EFI/BOOT/grubaa64.efi"
        shim: "BOOTAA64.EFI"
        ipxe_arch: "arm64-efi"
    temp_dir: "/tmp/fedora_boot"
    fedora_version: "37"
    boot_meta:
      x86_64:
        rpm_arch: "x86_64"
        shim_pkg: "shim-x64"
        grub_pkg: "grub2-efi-x64"
        src_shim: "shimx64.efi"
        src_grub: "grubx64.efi"
        dst_pxe: "BOOTX64.EFI"
      aarch64:
        rpm_arch: "aarch64"
        shim_pkg: "shim-aa64"
        grub_pkg: "grub2-efi-aa64"
        src_shim: "shimaa64.efi"
        src_grub: "grubaa64.efi"
        dst_pxe: "BOOTAA64.EFI"

- name: Set derived variables 1
  ansible.builtin.set_fact:
    remote_iso_name: "{{ os_base }}-{{ version }}-latest-{{ selected_arch }}-{{ iso_type }}.iso"

- name: Set derived variables 2
  ansible.builtin.set_fact:
    dest_path: "{{ base_dir }}/isos/{{ remote_iso_name }}"

- name: Extract SHA256 hash for the ISO
  ansible.builtin.set_fact:
    target_hash: >-
      {{ lookup('url', 'https://{}/{}/isos/{}/CHECKSUM'.format(base_url, version, selected_arch), split_lines=False)
        | regex_search('SHA256 \(' ~ (remote_iso_name | regex_escape) ~ '\) = ([a-f0-9]{64})', '\1')
        | first }}

- name: Downloading the latest {{ os_base }} {{ version }} ISO
  ansible.builtin.get_url:
    url: "https://{{ base_url }}/{{ version }}/isos/{{ selected_arch }}/{{ remote_iso_name }}"
    dest: "{{ dest_path }}"
    checksum: "sha256:{{ target_hash }}"
    mode: '0644'
    force: false
  register: download_result

- name: Show download status
  ansible.builtin.debug:
    msg: "ISO downloaded to {{ download_result.dest }}"

- name: Extract Boot Files (Kernel & Initrd)
  community.general.iso_extract:
    image: "{{ dest_path }}"
    dest: "{{ base_dir }}/tftp/{{ selected_arch }}"
    files:
      - "images/pxeboot/vmlinuz"
      - "images/pxeboot/initrd.img"
      #- "{{ boot_files[selected_arch].efi_loader }}"
      #- "{{ boot_files[selected_arch].grub_efi }}"

- name: Download and Extract RPMs
  shell: |
    set -e
    mkdir -p {{ temp_dir }} && cd {{ temp_dir }}

    URL="https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/{{ fedora_version }}/Everything/{{ boot_meta[selected_arch].rpm_arch }}/os/Packages"

    # Get latest Shim and Grub filenames
    SHIM_RPM=$(curl -sL $URL/s/ | grep -oP '{{ boot_meta[selected_arch].shim_pkg }}-[0-9][^">]+?\.{{ boot_meta[selected_arch].rpm_arch }}\.rpm' | head -1)
    GRUB_RPM=$(curl -sL $URL/g/ | grep -oP '{{ boot_meta[selected_arch].grub_pkg }}-[0-9. \-]+fc{{ fedora_version }}\.{{ boot_meta[selected_arch].rpm_arch }}\.rpm' | head -1)

    curl -sL -O "$URL/s/$SHIM_RPM"
    curl -sL -O "$URL/g/$GRUB_RPM"

    for rpm in *.rpm; do rpm2cpio $rpm | cpio -idmv; done
  args:
    executable: /bin/bash

- name: Deploy Shim as PXE entry point
  copy:
    src: "{{ temp_dir }}/boot/efi/EFI/fedora/{{ boot_meta[selected_arch].src_shim }}"
    dest: "{{ base_dir }}/tftp/{{ selected_arch }}/{{ boot_meta[selected_arch].dst_pxe }}"
    mode: '0644'
    remote_src: true

- name: Deploy GRUB second stage
  copy:
    src: "{{ temp_dir }}/boot/efi/EFI/fedora/{{ boot_meta[selected_arch].src_grub }}"
    dest: "{{ base_dir }}/tftp/{{ selected_arch }}/{{ boot_meta[selected_arch].src_grub }}"
    mode: '0644'
    remote_src: true

- name: Clean up temp dir
  file:
    path: "{{ temp_dir }}"
    state: absent

- name: Unpack Full ISO for HTTP Installation
  ansible.builtin.command:
    cmd: "7z x {{ dest_path }} -o{{ base_dir }}/www/{{ selected_arch }}/ -y"
  args:
    creates: "{{ base_dir }}/www/{{ selected_arch }}/BaseOS"

- name: Download the latest iPXE files
  ansible.builtin.get_url:
    url: "https://boot.ipxe.org/{{ boot_files[selected_arch].ipxe_arch }}/ipxe.efi"
    dest: "{{ base_dir }}/tftp/{{ selected_arch }}/ipxe.efi"
    mode: '0644'
    force: false
