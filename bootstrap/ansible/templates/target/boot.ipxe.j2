#!ipxe


# Architecture Detection
# iPXE uses 'arm64', but often ISOs use 'aarch64' as the folder name.
set arch_path ${arch}
isset ${arch} && goto arch_check || set arch_path x86_64

:arch_check
# Ensure the network interface is up
ifconf --ok || dhcp
# Map iPXE 'arm64' to common 'aarch64' naming convention if necessary
item --key a  aarch64  AArch64 (ARM)
item --key x  x86_64   x86_64 (Intel/AMD)

# Global Variables
set base_url http://{{ remote_server_ip }}:{{ pxe_http_port }}

:start
menu Generic iPXE Boot Menu [Arch: ${arch}]
item --gap --             ---------------- Operating Systems ----------------
item rescue               System Rescue (Generic)
item --gap --             ---------------- Advanced -------------------------
item shell                Drop to iPXE Shell
item reboot               Reboot Computer
choose --default shell --timeout 5000 target && goto ${target}

:rescue
echo Loading Rescue Environment...
kernel ${base_url}/${arch}/rescue/vmlinuz ip=dhcp
initrd ${base_url}/${arch}/rescue/initrd.img
boot

:shell
shell

:reboot
reboot
