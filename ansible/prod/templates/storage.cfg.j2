# PE defaults
dir: local
  path /var/lib/vz
  content iso,vztmpl,backup,import

lvmthin: local-lvm
  thinpool data
  vgname pve
  content rootdir,images

# Sata device (local access) ata-1 port
dir: {{ pe_storage_name }}
  path {{ data_path }}
  content images,iso,vztmpl,snippets
  is_mountpoint 1
  shared 0
