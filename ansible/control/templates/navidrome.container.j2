# Navidrome Podman Quadlet config - Managed by Ansible/Jinja2
[Unit]
Description=Navidrome Container
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/deluan/navidrome:latest
PublishPort={{ navidrome_port }}:{{ navidrome_port }}
Volume={{ navidrome_data_dir }}:/data:Z,U
Volume={{ navidrome_music_dir }}:/music:ro
AutoUpdate=registry

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
