[Unit]
Description=PXE tftp Component
After=pxe-pod.service
BindsTo=pxe-pod.service
PartOf=pxe-pod.service

[Container]
ContainerName=pxe_tftp
Image=docker.io/library/alpine:latest
Exec=/bin/sh -c "apk add --no-cache tftp-hpa && { syslogd -n -O /dev/stdout & } && exec /usr/sbin/in.tftpd --foreground -vvv --address 0.0.0.0:69 --map-file /etc/tftpd.map --secure /var/lib/tftpboot"
Volume={{ pxe_base_dir }}/configs/tftpd.map:/etc/tftpd.map:ro,Z
Volume={{ pxe_base_dir }}/tftp:/var/lib/tftpboot:Z
AddCapability=NET_BIND_SERVICE
Pod=pxe.pod

[Service]
Restart=on-failure
StartLimitIntervalSec=30
StartLimitBurst=5
