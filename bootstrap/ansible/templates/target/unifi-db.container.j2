[Unit]
Description=Unifi MongoDB

[Container]
ContainerName=unifi-db
Image=docker.io/mongo:8.0
EnvironmentFile={{ unifi_env_file }}
Volume={{ unifi_paths.db }}:/data/db:Z,U
Volume={{ unifi_paths.init }}:/docker-entrypoint-initdb.d:Z,U,ro
Pod=unifi-controller.pod

[Service]
Restart=on-failure
StartLimitIntervalSec=30
StartLimitBurst=5
