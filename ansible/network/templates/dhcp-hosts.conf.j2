{% if reservation.ref_name | default('') %}
# {{ reservation.ref_name }}
{% endif %}
{{ reservation.mac }},{{ reservation.ipv4 }}{{ ',' ~ reservation.name if reservation.name | default('') else '' }}
{% endfor %}
