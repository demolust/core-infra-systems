# Vault containerized hcl config - Managed by Ansible/Jinja2
api_addr     = "http://127.0.0.1:8200"
cluster_addr = "http://127.0.0.1:8201"

storage "raft" {
  path    = "{{ vault_internal_data }}"
  node_id = "node1"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = "true"
}

seal "static" {
  current_key_id = "unseal-static-1"
  current_key    = "env://VAULT_UNSEAL_KEY"
}

disable_mlock = true
ui = true
