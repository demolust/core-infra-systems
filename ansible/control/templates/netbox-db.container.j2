# NetBox DB Podman Quadlet config - Managed by Ansible/Jinja2
[Unit]
Description=NetBox PostgreSQL Database

[Container]
ContainerName=netbox-postgres
Image=docker.io/library/postgres:15-alpine
EnvironmentFile={{ netbox_env_file }}
Volume={{ netbox_paths.db }}:/var/lib/postgresql/data:Z
Pod=netbox.pod

[Service]
Restart=on-failure
StartLimitIntervalSec=30
StartLimitBurst=5
