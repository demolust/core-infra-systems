# OpenBao containerized hcl config - Managed by Ansible/Jinja2
api_addr     = "http://127.0.0.1:8200"
cluster_addr = "http://127.0.0.1:8201"

storage "raft" {
  path    = "/openbao/data"
  node_id = "node1"
}

listener "tcp" {
  address     = "0.0.0.0:{{ vault_ports }}"
  tls_disable = "true"
}

disable_mlock = true
ui = true
