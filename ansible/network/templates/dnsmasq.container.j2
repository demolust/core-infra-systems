# dnsmasq Podman Quadlet config - Managed by Ansible/Jinja2
[Unit]
Description=Container dnsmasq
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=dnsmasq
Image=docker.io/4km3/dnsmasq
Volume={{ dnsmasq_config_dir }}/dnsmasq.conf:/etc/dnsmasq.conf:ro,Z
Volume={{ dnsmasq_config_dir }}/dhcp-hosts.conf:/etc/dnsmasq.d/dhcp-hosts.conf:ro,Z
Volume={{ dnsmasq_state_dir }}:/var/lib/dnsmasq:Z
AddCapability=NET_ADMIN NET_BIND_SERVICE NET_RAW
Network=host

[Service]
Restart=on-failure
StartLimitBurst=5

[Install]
WantedBy=default.target
